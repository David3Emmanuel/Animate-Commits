{
  "name": "animate-commits",
  "version": "0.1.0",
  "description": "Animate a git commit as if it were being written in VS Code, using your current theme.",
  "type": "module",
  "bin": {
    "animate-commits": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup src/cli.ts --format esm --platform node --target node20 --out-dir dist --clean && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:motion": "tsx tests/render-smoke/run.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@vscode/codicons": "^0.0.36",
    "commander": "^14.0.1",
    "diff": "^8.0.2",
    "jsonc-parser": "^3.3.1",
    "open": "^10.2.0",
    "playwright-core": "^1.55.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
